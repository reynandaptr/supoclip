# Two files, both outside Git, mode 600.
#
# 1) Compose variables: ~/.config/supoclip/worker-compose.env, passed with --env-file.
WORKER_DATABASE_URL=postgresql+asyncpg://supoclip:<POSTGRES_PASSWORD>@100.98.156.81:15432/supoclip
WORKER_REDIS_HOST=100.98.156.81
WORKER_REDIS_PORT=16379
# WORKER_IMAGE=ghcr.io/reynandaptr/supoclip-backend-cuda:latest
# WORKER_ENV_FILE=/home/<you>/.config/supoclip/worker.env
# WORKER_SCRATCH_PATH=/home/<you>/.local/share/supoclip-worker/scratch
# WHISPER_MODEL_SIZE=turbo

# 2) Service credentials: ~/.config/supoclip/worker.env (WORKER_ENV_FILE), read raw by the
#    container. Same values as the VPS Dokploy environment, so the worker and the API agree:
#
#    REDIS_PASSWORD=
#    BACKEND_AUTH_SECRET=
#    APP_SETTINGS_ENCRYPTION_KEY=
#    MEDIA_S3_BUCKET=
#    MEDIA_S3_ENDPOINT=
#    MEDIA_S3_REGION=auto
#    MEDIA_S3_PREFIX=media
#    MEDIA_S3_ACCESS_KEY_ID=
#    MEDIA_S3_SECRET_ACCESS_KEY=
#    PUBLIC_API_URL=http://backend:8000
#    NEXT_PUBLIC_APP_URL=https://supoclip.reynandaptr.dev
#    SELF_HOST=true
#    MANUAL_CLIP_EDITS_ENABLED=false
#    LLM=google-gla:gemini-3-flash-preview
#    GOOGLE_API_KEY=
#    (plus any other provider/processing setting set on the VPS: OPENAI_API_KEY,
#     ANTHROPIC_API_KEY, OPENROUTER_API_KEY, YOUTUBE_*, DEFAULT_PROCESSING_MODE, MAX_CLIPS, ...)
