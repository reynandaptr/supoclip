# Dokploy environment for deploy/dokploy/compose.yml. Dummy values only; real ones live in Dokploy.
# Secrets: generate each with `openssl rand -hex 32` (hex keeps them URL-safe for DATABASE_URL).

# --- Required ---
POSTGRES_PASSWORD=change-me-hex-32
MEDIA_S3_BUCKET=supoclip-media
MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
REDIS_PASSWORD=change-me-hex-32
BACKEND_AUTH_SECRET=change-me-hex-32
APP_SETTINGS_ENCRYPTION_KEY=change-me-hex-32
BETTER_AUTH_SECRET=change-me-hex-32

# --- R2 credentials (bucket-scoped token, object read/write) ---
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# --- AI providers (carry over the values the local stack uses) ---
LLM=google-gla:gemini-3-flash-preview
GOOGLE_API_KEY=

